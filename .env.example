# VERIS — environment template. NAMES ONLY. Copy to `.env` only for local development.
# Hosted deployments do not load `.env`; inject every setting through the deployment
# environment or its secret manager.
#
# NO VALUES IN THIS FILE, EVER. A template that carries a real credential is worse than
# no template, because it is committed, it looks like documentation, and it is the last
# place anyone thinks to look for a leak. This file lists variable NAMES and explains
# what each one does. `.env` is gitignored; `scripts/scan_repo.py` fails the build on a
# key-shaped literal anywhere in the repository.
#
# NONE OF IT IS REQUIRED. The product runs and the full test suite passes with none of
# it set. A model profile adds evidence-bound clause proposals, plain-language explanation
# and navigation wording. It does not add authority — no model decides whether cover
# exists, resolves precedence, computes or adjusts a settlement figure, sets an evidence
# class or produces a score. The test suite asserts that boundary against the import graph.
#
# With no usable profile the interface reports DETERMINISTIC_ONLY and names lexical
# retrieval as the mode in use. A product that silently falls back while implying more
# automation would make exactly the kind of unstated claim this system exists to refuse.

# ── hosted security posture ────────────────────────────────────────────────
# Set VERIS_MODE=hosted only behind HTTPS. Hosted mode requires a login on workspace
# routes, disables interactive API documentation, enforces CSRF double-submit tokens,
# uses Secure session cookies, and reads secrets from process environment only.
#
# VERIS_AUTH_DB_PATH holds invite-only judge/reviewer accounts outside the repository.
# VERIS_JUDGE_INVITE_CODES is a deployment-secret JSON object mapping one-time invite
# codes to SME, ADVISER or REVIEWER roles. Do not put codes in this file or the image.
# VERIS_RECORD_HMAC_KEY is at least 32 bytes and authenticates hosted portable exports.
# VERIS_OUTBOUND_ALLOWLIST optionally adds reviewed HTTPS hostnames to the built-in list.
# The parser limits apply to each isolated untrusted-PDF child process in hosted mode.
VERIS_MODE=
VERIS_AUTH_DB_PATH=
VERIS_REVIEW_DB_PATH=
VERIS_JUDGE_INVITE_CODES=
VERIS_RECORD_HMAC_KEY=
VERIS_OUTBOUND_ALLOWLIST=
VERIS_MAX_REQUEST_BYTES=
VERIS_PDF_PARSE_TIMEOUT_SECONDS=
VERIS_PDF_PARSE_MEMORY_BYTES=

# ── the model layer (optional) ──────────────────────────────────────────────
# One redacting OpenAI-compatible boundary serves all model-capable features. Set
# VERIS_LLM_PROFILE to `openai`, `deepseek`, `qwen`, `ollama` or `none`. `none` is the
# deterministic profile and is safe for local demonstrations and all tests.
#
# Profile defaults: openai -> https://api.openai.com/v1 / gpt-4o-mini; deepseek ->
# https://api.deepseek.com/v1 / deepseek-chat; qwen ->
# https://dashscope.aliyuncs.com/compatible-mode/v1 / qwen-plus; ollama ->
# http://localhost:11434/v1 / llama3.2. VERIS_LLM_BASE_URL and VERIS_LLM_MODEL override
# those defaults. Set VERIS_LLM_MODEL_VERSION to an immutable deployment pin when the
# provider supports one; a provider-returned model identifier takes precedence in each
# prompt audit record. If neither is available, model_version is recorded as unavailable
# rather than treating a mutable configured model alias as a version. Leave every key
# unset to keep deterministic operation.
VERIS_LLM_PROFILE=
VERIS_LLM_BASE_URL=
VERIS_LLM_MODEL=
VERIS_LLM_MODEL_VERSION=
VERIS_LLM_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Compatibility names used by older local setups. PROVEN_CHAT_MODEL is read only when
# VERIS_LLM_MODEL is unset; model transport still goes through the shared boundary.
PROVEN_CHAT_MODEL=

# Seconds before one model call is abandoned. The optional budgets count estimated tokens
# per tenant and process; a budget or transport failure uses the deterministic response.
VERIS_LLM_TIMEOUT=
VERIS_LLM_RETRIES=
VERIS_LLM_TENANT_TOKEN_BUDGET=
VERIS_LLM_GLOBAL_TOKEN_BUDGET=
PROVEN_AI_TIMEOUT=

# ── the document corpus ─────────────────────────────────────────────────────
# Where the published insurer wordings, statute text and judgment live. They are
# third-party copyrighted material and are NOT in git. Defaults to `../veris-corpus`.
# Populate it with:
#     python scripts/fetch_corpus.py --seed-from ../06-evidence
# `corpus/manifest.yaml` records the publisher, source URL and sha256 of every document,
# so any citation can be re-checked at source by someone who has only this repository.
VERIS_CORPUS_DIR=

# Point an installed package at the manifest it was built against. Unset is correct when
# running from a checkout.
VERIS_CORPUS_MANIFEST=

# ── durable portfolio storage ───────────────────────────────────────────────
# File-backed household and business records. Set the database path outside the
# repository or in another ignored data directory. VERIS_MASTER_KEY is URL-safe base64
# for exactly 32 random bytes and wraps each tenant's separate AES-GCM data key. In local
# development only, leaving it unset creates a gitignored `.veris-dev-master-key` beside
# the configured database; hosted deployments must provide VERIS_MASTER_KEY. Removing a
# tenant key validates secure deletion from the local database, WAL and shared-memory
# artifacts; backup retention and physical-media destruction remain hosting operations.
VERIS_PORTFOLIO_DB_PATH=
VERIS_MASTER_KEY=
VERIS_DEV_MASTER_KEY_PATH=

# ── private synthetic counterparty ────────────────────────────────────────────
# The optional claim-to-correction composition uses a private synthetic insurer/bank
# service only. Local and hosted Compose both keep it off published ports; set
# VERIS_SANDBOX_URL only to `http://sandbox:8200` (Compose) or a loopback port 8200.
# Other destinations are rejected before any claim or payment data is sent. Generate a
# fresh URL-safe base64 value for exactly 32 random bytes as the client secret, inject it
# only into the VERIS and sandbox services, and keep the signing key and local-only
# administrator token out of the owner browser. In hosted Compose the signing key belongs
# only to the sandbox service. VERIS_LOCAL_CORPUS_DIR is the host path mounted read-only at
# /corpus by docker compose; it is not an application setting.
VERIS_SANDBOX_URL=
VERIS_SANDBOX_CLIENT_ID=
VERIS_SANDBOX_CLIENT_SECRET=
VERIS_SANDBOX_SIGNING_KEY=
VERIS_LOCAL_SANDBOX_ADMIN_TOKEN=
VERIS_LOCAL_CORPUS_DIR=

# ── live external data sources ──────────────────────────────────────────────
# OFF by default. Set to 1 and the monitoring and discovery agents and the drift index
# make REAL outbound calls to government open-data endpoints: rainfall and forecast,
# the statistics table builder, the company register, and geocoding. Each call has a
# timeout and falls back to a LABELLED fixture on failure — a fixture is never rendered
# as live.
#
# Leave this unset when running the tests. The suite must not need a network round trip,
# and `tests/conftest.py` forces it off for the whole process regardless of the shell,
# because it leaked in once and turned a 90-second offline run into a nine-minute run
# with failures. The live paths are still exercised, by mocking the HTTP layer.
PROVEN_LIVE_SOURCES=

# ── the example business's own website ──────────────────────────────────────
# The worked example is a fictional company, so its domain does not resolve and every
# live discovery run against it died on DNS — which meant the one capability the agent
# exists to show, noticing a change a business published but never told its insurer,
# could not be demonstrated at all.
#
# So the repo ships that website as a SEPARATE process and points discovery at it. What
# the product does to it is a genuine outbound HTTP GET: real request, real HTML, real
# parsing, real grounding gate. Only the company is a stand-in.
#
#     python demo-site/site.py          # -> http://127.0.0.1:8100
#
# Then open /operator on that port to change the business live and watch the app notice
# on its next check. A real deployment points this at the customer's actual URL and
# nothing else changes.
PROVEN_DEMO_SITE_URL=

# ── email notifications ─────────────────────────────────────────────────────
# Unset by default, and the behaviour with nothing configured is deliberate rather than
# degraded: every notification is still COMPOSED IN FULL and written to an outbox you can
# read in the app, marked NO_MAIL_SERVER. Nothing claims to have been delivered when it
# was not. A "sent" toast with nothing on the wire is the same unstated claim this
# product refuses to make anywhere else.
#
# Set both HOST and FROM to send for real. Port 465 uses SMTP over SSL; anything else
# uses STARTTLS unless TLS is explicitly disabled. Credentials are optional — some relays
# do not want them. The status endpoint reports whether a password is PRESENT, never what
# it is.
PROVEN_SMTP_HOST=
PROVEN_SMTP_PORT=
PROVEN_SMTP_USER=
PROVEN_SMTP_PASSWORD=
PROVEN_SMTP_FROM=
PROVEN_SMTP_TLS=

# Where notifications actually go. The demo accounts use a domain that can never receive
# mail, so without this, mail is composed and shown in the outbox rather than sent to an
# address guaranteed to bounce.
PROVEN_NOTIFY_TO=
